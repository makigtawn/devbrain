# Copy to `.env.production` before running `npm run build` / `npm run package`.
# Plasmo inlines PLASMO_PUBLIC_* into the bundle at build time, so these values ship
# inside the published extension — only ever put public values here. The Supabase anon
# key is public by design; the service_role key must never appear in this file.
#
# `.env.local` (gitignored) is the dev equivalent, used by `npm run dev`.

PLASMO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
PLASMO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Your deployed web app's origin, no trailing slash. The extension POSTs page selections
# to `${PLASMO_PUBLIC_API_BASE_URL}/api/extension/entries`. Leaving this at localhost in a
# production build ships an extension that can only talk to the developer's own machine.
PLASMO_PUBLIC_API_BASE_URL=https://your-devbrain-domain.com

